{
  // ALTERNATE CONFIG — the working-tree variant. VS Code offers a picker when a
  // repository has more than one devcontainer.json; pick "devbase (working tree)" to
  // build your environment from features/src/ instead of from the registry.
  //
  // Run `pnpm devbase:local` first. It copies features/src/devbase to ./devbase here,
  // which is gitignored. The copy is unavoidable: the CLI refuses a local Feature path
  // that resolves outside .devcontainer/ (so ../../features/src/devbase is rejected) and
  // fails the fetch step on a symlink. Because this config sits at .devcontainer/local/,
  // its "./devbase" resolves to .devcontainer/local/devbase — inside .devcontainer/, so
  // it is accepted.
  //
  // Re-run `pnpm devbase:local` after every edit to the Feature, then rebuild. Forgetting
  // is the one hazard of a copy, which is why the default config uses the registry and
  // why `pnpm features:test` — which always reads features/src/ directly — is the normal
  // iteration loop.
  //
  // Deliberately leaner than the default config: this exists to exercise the Feature, not
  // to be a comfortable daily environment.
  "name": "dstack-devcontainer-features (working tree)",
  "image": "mcr.microsoft.com/devcontainers/base:2-ubuntu-24.04",

  "workspaceMount": "source=${localWorkspaceFolder},target=/usr/share/${localWorkspaceFolderBasename},type=bind,consistency=cached",
  "workspaceFolder": "/usr/share/${localWorkspaceFolderBasename}",
  "shutdownAction": "stopContainer",

  "features": {
    // Needed to run `pnpm features:test` from inside this container.
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    // node and github-cli come from devbase's `dependsOn` — see the default config. Here
    // they exercise it straight from the working-tree copy, which is why this list can
    // shrink without waiting for a release the way the default one must. That also means
    // this config is where the claude-code removal takes effect first: unlike the default
    // frame, it has no published `:1` to keep the CLI alive, so a container built here has
    // no `claude` on PATH as soon as the working tree drops it.
    "./devbase": {}
  },

  "remoteUser": "vscode",

  // Two jobs, and it has to stay ONE key: devcontainer.json is JSON, so a second
  // "initializeCommand" does not merge or error — it silently replaces the first, and both
  // prettier and the CLI accept it. This file briefly had exactly that, which discarded the
  // drift check while looking correct.
  //
  // check-devbase-local.sh comes first and fails the build when ./devbase has drifted from
  // features/src/devbase — the one way this config can quietly lie to you.
  "initializeCommand": "bash scripts/check-devbase-local.sh && mkdir -p ${localEnv:HOME}/.claude && touch ${localEnv:HOME}/.gitconfig ${localEnv:HOME}/.zsh_history",

  // Kept identical in shape to the live frame's mounts, for the same reasons stated
  // there at length: one named path each, readonly unless the container has to write it,
  // and the host's ~/.zsh_history bound as that file rather than the home directory it
  // sits in (RSRMID-3052).
  "mounts": [
    "source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind,readonly",
    "source=${localEnv:HOME}/.zsh_history,target=/WSL_USER/.zsh_history,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached"
  ]
}
